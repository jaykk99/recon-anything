+# REVAL PATCH (worktree-only, 2026-11-14): atomic checkpoint write.
+# Pure side effect; never read during training, so it cannot change
+# the trajectory.
+def _write_checkpoint(path: str, net: "MLP", epochs_done: int) -> None:
+    data = net.to_dict()
+    data["epochs_done"] = int(epochs_done)
+    tmp = f"{path}.tmp"
+    with open(tmp, "w", encoding="utf-8") as fh:
+        json.dump(data, fh)
+    os.replace(tmp, path)
