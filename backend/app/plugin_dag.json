ed_endpoints","from":"etcd_raft_consensus_keyspace_dumper","to":"bank"},{"artifact":"exposed_endpoints","from":"consul_gossip_serf_member_enumerator","to":"bank"},{"artifact":"exposed_endpoints","from":"oidc_jwks_kid_cache_poison_surface_check","to":"bank"},{"artifact":"trust_graph","from":"aws_sts_assume_role_trust_policy_grapher","to":"bank_surface"},{"artifact":"trust_graph","from":"aws_sts_assume_role_trust_policy_grapher","to":"evidence_pack"},{"artifact":"saml_lint","from":"saml_xml_signature_wrapping_structural_linter","to":"evidence_pack"},{"artifact":"kerberos_audit","from":"kerberos_spn_asrep_roastability_auditor","to":"evidence_pack"},{"artifact":"delegation_paths","from":"ldap_schema_acl_delegation_pathfinder","to":"evidence_pack"},{"artifact":"drift_report","from":"terraform_state_backend_drift_extractor","to":"evidence_pack"},{"artifact":"cve_links","from":"sbom_cyclonedx_transitive_cve_linker","to":"evidence_pack"},{"artifact":"opsec_exposure","from":"stylometry_commit_cadence_timezone_profiler","to":"evidence_pack"},{"artifact":"sandbox_audit","from":"agent_sandbox_syscall_deterministic_guard","to":"evidence_pack"}],"layers":{"-1":"harness guard: wraps every plugin run, not a producer","0":"parsers: turn raw bytes/text into structured artifacts","1":"analyzers: pattern + symbolic checks over parser artifacts and source","2":"correlators: combine analyzer outputs across contracts, bundles, chains","3":"harness consumers: evidence pack, auto-validator, existing surface detectors"},"name":"recon-anything-plugin-dag","nodes":[{"consumes":["sandbox_config"],"file":"backend/app/plugins/deep_infra.py","harness_module":"backend/app/agent_sandbox_guard.py","id":"agent_sandbox_syscall_deterministic_guard","kind":"harness_plugin","layer":-1,"note":"Guards every plugin run (rlimits, env scrub, cwd jail, timeout, audit log). True seccomp-bpf filtering is NOT claimed; the guard reports it as unenforceable-here.","produces":["sandbox_audit"]},{"consumes":["verified_source","bytecode"],"file":"backend/app/plugins/deep_lowlevel.py","id":"evm_cfg_basic_block_reconstructor","kind":"plugin","layer":0,"note":"Reconstructs basic blocks and guard dominance from source control flow.","produces":["cfg_blocks"]},{"consumes":["bytecode"],"file":"backend/app/plugins/deep_lowlevel.py","id":"eof_container_code_section_verifier","kind":"plugin","layer":0,"note":"Parses EOF containers (0xEF00) and verifies section bounds and jump targets.","produces":["verified_code_sections"]},{"consumes":["state_proof","state_root"],"file":"backend/app/plugins/deep_lowlevel.py","id":"merkle_patricia_trie_state_proof_verifier","kind":"plugin","layer":0,"note":"Verifies MPT state proofs against a trusted root; fires when a proof does NOT verify.","produces":["state_proofs"]},{"consumes":["program_elf"],"file":"backend/app/plugins/deep_solana.py","id":"solana_bpf_elf_syscalls_disassembler","kind":"plugin","layer":0,"note":"Disassembles Solana BPF ELF, maps CALL immediates to syscalls.","produces":["syscall_map","program_accounts"]},{"consumes":["wasm_module"],"file":"backend/app/plugins/deep_infra.py","id":"wasm_linear_memory_export_inspector","kind":"plugin","layer":0,"note":"Parses WASM sections; flags exported linear memory without bounds.","produces":["wasm_memory_exports"]},{"consumes":["wire_bytes"],"file":"backend/app/plugins/deep_infra.py","id":"protobuf_wire_format_schema_inferrer","kind":"plugin","layer":0,"note":"Infers protobuf field schemas from raw wire bytes; flags schema drift.","produces":["inferred_schemas"]},{"consumes":["git_packfile"],"file":"backend/app/plugins/deep_infra.py","id":"git_packfile_dangling_blob_carver","kind":"plugin","layer":0,"note":"Carves dangling blobs from a supplied packfile; flags secrets in deleted history.","produces":["carved_blobs"]},{"consumes":["image_layers"],"file":"backend/app/plugins/deep_infra.py","id":"container_overlayfs_whiteout_layer_differ","kind":"plugin","layer":0,"note":"Diffs overlayfs layers; flags whiteouts hiding secrets and resurrected files.","produces":["layer_diffs"]},{"consumes":["cfg_blocks","verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"symbolic_z3_storage_taint_tracer","kind":"plugin","layer":1,"note":"Z3 bit-vector proof that attacker input can force a storage slot to a chosen value. Bounded, 5s solver timeout.","produces":["tainted_slots"]},{"consumes":["verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"diamond_erc2535_facet_selector_tree","kind":"plugin","layer":1,"note":"Builds selector->facet map from diamondCut sites; flags Add-overwrite, Remove-dangling, fallback shadowing. Gap vs diamond_selector_collision (same-signature across contracts).","produces":["selector_tree"]},{"consumes":["verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"transient_storage_tstore_lifecycle_auditor","kind":"plugin","layer":1,"note":"TSTORE/TLOAD lifecycle: uninitialized reads and cross-meaning slot reuse.","produces":["transient_slots"]},{"consumes":["verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"erc4337_entrypoint_paymaster_simulator","kind":"plugin","layer":1,"note":"SIMULATION ONLY. Simulates EntryPoint gas accounting against a paymaster; findings are UNVERIFIED candidates, never proof.","produces":["paymaster_drain_shape"]},{"consumes":["verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"erc7579_modular_account_hook_inspector","kind":"plugin","layer":1,"note":"Inspects ERC-7579 hooks: unguarded installModule, hooks that skip validation.","produces":["hook_graph"]},{"consumes":["verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"zk_snark_verifier_vk_parameter_auditor","kind":"plugin","layer":1,"note":"Audits verification-key parameters: zero/trivial values, vk reuse across circuits.","produces":["vk_audit"]},{"consumes":["verified_source","circom_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"circom_r1cs_underconstrained_wire_checker","kind":"plugin","layer":1,"note":"R1CS wire-level: wires used in outputs but never constrained. Gap vs underconstrained_signal_finder (signal-level).","produces":["unconstrained_wires"]},{"consumes":["verified_source","circom_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"halo2_lookup_table_range_profiler","kind":"plugin","layer":1,"note":"Profiles halo2 lookup table ranges vs input domain. Gap vs halo2_lookup_verifier (lookup existence).","produces":["lookup_ranges"]},{"consumes":["verified_source"],"file":"backend/app/plugins/deep_lowlevel.py","id":"gnosis_safe_fallback_handler_mutator_check","kind":"plugin","layer":1,"note":"Flags fallback-handler changes reachable without owner/threshold, and handlers delegating to user input. Gap vs gnosis_safe_multisig_audit (multisig config).","produces":["fallback_handler_audit"]},{"consumes":["program_accounts","idl"],"file":"backend/app/plugins/deep_solana.py","id":"anchor_discriminator_collision_fuzzer","kind":"plugin","layer":1,"note":"Computes Anchor discriminators (sha256 account:<Name>[:8]) and fuzzes name variants for collisions. Simulation/differential only: findings are UNVERIFIED candidates.","produces":["discriminator_map"]},{"consumes":["syscall_map","program_accounts","rust_source"],"file":"backend/app/plugins/deep_solana.py","id":"solana_cpi_privilege_escalation_tracer","kind":"plugin","layer":1,"note":"Traces CPI calls for missing signer/owner/writable checks and user-controlled seeds.","produces":["cpi_traces"]},{"consumes":["program_id","mint_account"],"file":"backend/app/plugins/deep_solana.py","id":"token2022_transfer_hook_program_resolver","kind":"plugin","layer":1,"note":"Resolves Token-2022 transfer hooks; flags missing/zero or single-authority-upgradable hooks.","produces":["transfer_hook_resolution"]},{"consumes":["lookup_table_account"],"file":"backend/app/plugins/deep_solana.py","id":"alt_address_lookup_table_resolver","kind":"plugin","layer":1,"note":"Resolves ALT addresses; flags deactivated tables still referenced and address confusion.","produces":["resolved_addresses"]},{"consumes":["target_prefixes"],"file":"backend/app/plugins/deep_infra.py","id":"bgp_rpki_roa_hijack_anomaly_detector","kind":"plugin","layer":1,"note":"Passive: reads public RPKI/route data for the target's prefixes; flags RPKI-invalid announcements. Gap vs bgp_route_leak_detector (route leaks).","produces":["routing_anomaly"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"quic_initial_packet_version_fingerprinter","kind":"plugin","layer":1,"note":"Passive: fingerprints QUIC versions from the target's own Initial packet on a normal connection.","produces":["tls_fingerprint"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"ja4_tls_client_hello_entropy_profiler","kind":"plugin","layer":1,"note":"Passive: profiles the target TLS server's JA4 fingerprint and entropy across connections.","produces":["tls_fingerprint"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"tcp_isn_clock_skew_uptime_estimator","kind":"plugin","layer":1,"note":"Passive: estimates uptime/clock skew from ISNs observed during normal handshakes the scan already makes.","produces":["tls_fingerprint"]},{"consumes":["target_domain"],"file":"backend/app/plugins/deep_infra.py","id":"dnssec_nsec3_zone_walker","kind":"plugin","layer":1,"note":"Passive: walks the target's own NSEC3 chain via public DNS; flags enumerable zones and broken chains.","produces":["zone_exposure"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"anycast_pop_bgp_latency_triangulator","kind":"plugin","layer":1,"note":"Passive: triangulates anycast PoPs from the timing of fetches the scan already performs.","produces":["routing_anomaly"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"http3_qpack_dynamic_table_fingerprinter","kind":"plugin","layer":1,"note":"Passive: fingerprints the target's QPACK dynamic table from its HTTP/3 responses.","produces":["tls_fingerprint"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"ebpf_xdp_packet_drop_signature_prober","kind":"plugin","layer":1,"note":"Detection-equivalent: infers XDP drop signatures from connection outcomes (timeout vs RST) of normal fetches. No port sweep.","produces":["drop_signature"]},{"consumes":["heap_snapshot"],"file":"backend/app/plugins/deep_infra.py","id":"v8_heap_snapshot_closure_secret_extractor","kind":"plugin","layer":1,"note":"Extracts secrets captured in closures of a supplied V8 heap snapshot. Gap vs v8_heap_snapshot_parser (parsing).","produces":["extracted_secrets"]},{"consumes":["asar_package"],"file":"backend/app/plugins/deep_infra.py","id":"electron_asar_integrity_bypass_checker","kind":"plugin","layer":1,"note":"Checks asar integrity metadata; flags missing hashes and hash mismatches. Gap vs asar_unpacker_stream (unpacking).","produces":["extracted_secrets"]},{"consumes":["apk_native_lib"],"file":"backend/app/plugins/deep_infra.py","id":"mobile_apk_native_jni_symbol_dumper","kind":"plugin","layer":1,"note":"Dumps JNI symbols from a supplied APK native .so; flags exported symbols handling sensitive data.","produces":["extracted_secrets"]},{"consumes":["macho_binary"],"file":"backend/app/plugins/deep_infra.py","id":"ios_macho_entitlement_plist_extractor","kind":"plugin","layer":1,"note":"Extracts entitlements from a supplied Mach-O; flags dangerous entitlements widening privileges.","produces":["extracted_secrets"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"graphql_federation_subgraph_entity_resolver","kind":"plugin","layer":1,"note":"Passive: resolves federated entities via the target's public GraphQL schema; flags unauthenticated _entities.","produces":["exposed_endpoints"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"mqtt_wildcard_topic_acl_enumerator","kind":"plugin","layer":1,"note":"Passive: checks whether the target's public broker permits anonymous wildcard subscription. Stops at auth-required.","produces":["exposed_endpoints"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"etcd_raft_consensus_keyspace_dumper","kind":"plugin","layer":1,"note":"Detection-equivalent: checks whether the target's etcd serves its keyspace without auth. Reports exposure + key count only, never values.","produces":["exposed_endpoints"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"consul_gossip_serf_member_enumerator","kind":"plugin","layer":1,"note":"Passive: checks whether the target's Consul exposes its Serf member list without auth.","produces":["exposed_endpoints"]},{"consumes":["trust_policy"],"file":"backend/app/plugins/deep_infra.py","id":"aws_sts_assume_role_trust_policy_grapher","kind":"plugin","layer":1,"note":"Graphs a supplied STS trust policy; flags AssumeRole from * or an external account without external-id.","produces":["trust_graph"]},{"consumes":["target_url"],"file":"backend/app/plugins/deep_infra.py","id":"oidc_jwks_kid_cache_poison_surface_check","kind":"plugin","layer":1,"note":"Passive: reads the target's public JWKS; flags colliding kid values and key confusion.","produces":["exposed_endpoints"]},{"consumes":["saml_xml"],"file":"backend/app/plugins/deep_infra.py","id":"saml_xml_signature_wrapping_structural_linter","kind":"plugin","layer":1,"note":"Lints supplied SAML XML; flags signature-wrapping shapes (duplicate IDs, assertion outside signed subtree).","produces":["saml_lint"]},{"consumes":["directory_listing"],"file":"backend/app/plugins/deep_infra.py","id":"kerberos_spn_asrep_roastability_auditor","kind":"plugin","layer":1,"note":"Flags SPNs with pre-auth disabled (AS-REP roastable) from supplied directory data. Never performs the roast.","produces":["kerberos_audit"]},{"consumes":["ldap_acl_dump"],"file":"backend/app/plugins/deep_infra.py","id":"ldap_schema_acl_delegation_pathfinder","kind":"plugin","layer":1,"note":"Traces LDAP ACL delegation paths from a supplied dump; flags paths granting unintended write access.","produces":["delegation_paths"]},{"consumes":["terraform_state"],"file":"backend/app/plugins/deep_infra.py","id":"terraform_state_backend_drift_extractor","kind":"plugin","layer":1,"note":"Extracts drift from a supplied Terraform state file; flags unencrypted/public backends.","produces":["drift_report"]},{"consumes":["sbom"],"file":"backend/app/plugins/deep_infra.py","id":"sbom_cyclonedx_transitive_cve_linker","kind":"plugin","layer":1,"note":"Links a supplied CycloneDX SBOM to CVEs; flags transitive deps with CVEs hidden from the direct list.","produces":["cve_links"]},{"consumes":["commit_metadata"],"file":"backend/app/plugins/deep_infra.py","id":"stylometry_commit_cadence_timezone_profiler","kind":"plugin","layer":1,"note":"OSINT only, never a vulnerability detector: profiles PUBLIC commit metadata (timezone offsets, cadence) and flags OPSEC exposure. Never identifies a private individual.","produces":["opsec_exposure"]},{"consumes":["resolved_addresses","bundle"],"file":"backend/app/plugins/deep_solana.py","id":"jito_bundle_tip_auction_correlator","kind":"plugin","layer":2,"note":"Correlates Jito bundle tips with sandwich shapes and tip routing anomalies in public bundle data.","produces":["bundle_correlation"]},{"consumes":["state_proofs","batch_feed"],"file":"backend/app/plugins/deep_l2.py","id":"cross_rollup_sequencer_liveness_monitor","kind":"plugin","layer":2,"note":"Monitors a rollup sequencer's public batch feed; flags stalls and empty-batch censorship shapes.","produces":["liveness_gaps"]},{"consumes":["liveness_gaps","dispute_contract"],"file":"backend/app/plugins/deep_l2.py","id":"optimistic_fraud_proof_challenge_window_tracker","kind":"plugin","layer":2,"note":"Tracks the fraud-proof challenge window via read-only eth_call; flags windows below the security minimum.","produces":["challenge_window"]},{"consumes":["blob_sidecars"],"file":"backend/app/plugins/deep_l2.py","id":"blob_kzg_commitment_da_correlator","kind":"plugin","layer":2,"note":"Correlates blob KZG commitments with DA availability via the public beacon API; flags unretrievable blobs. Full KZG proof verification is out of scope and recorded as such.","produces":["da_gaps"]},{"consumes":["extracted_secrets","carved_blobs"],"file":"backend/app/plugins/cryptopack_secrets.py","id":"cp_secret_nsec","kind":"existing_plugin","layer":3,"note":"Existing secret detector; consumes extracted_secrets from the artifact inspectors.","produces":["secret_findings"]},{"consumes":["routing_anomaly","exposed_endpoints","zone_exposure"],"file":"backend/app/plugins/bank.py","id":"bank","kind":"existing_plugin","layer":3,"note":"Existing bank surface detector; consumes routing and endpoint exposure from the infra fingerprinters.","produces":["bank_surface_findings"]},{"consumes":["tls_fingerprint","zone_exposure","trust_graph"],"file":"backend/app/plugins/bank_surface.py","id":"bank_surface","kind":"existing_plugin","layer":3,"note":"Existing bank surface detector; consumes TLS fingerprints and trust graphs.","produces":["bank_surface_findings"]},{"consumes":["routing_anomaly","drop_signature","tls_fingerprint"],"file":"backend/app/plugins/bridge.py","id":"bridge","kind":"existing_plugin","layer":3,"note":"Existing bridge detector; consumes routing anomalies, drop signatures, TLS fingerprints.","produces":["bridge_findings"]},{"consumes":["cfg_blocks","tainted_slots","selector_tree","transient_slots","paymaster_drain_shape","hook_graph"],"file":"in-flight (separate builder)","id":"zeroday_exploit_chain","kind":"planned_plugin","layer":3,"note":"In-flight 0-day composite detector (separate builder). Consumes the low-level analyzer outputs; its findings are UNVERIFIED candidates until the live probe.","produces":["exploit_chain_candidates"]},{"consumes":["cfg_blocks","transient_slots"],"file":"in-flight (separate builder)","id":"business_logic_invariants","kind":"planned_plugin","layer":3,"note":"In-flight manual-methodology builder. Consumes CFG blocks and transient-slot maps for invariant checks.","produces":["invariant_candidates"]},{"consumes":["vk_audit","unconstrained_wires","lookup_ranges","fallback_handler_audit","trust_graph","drift_report","cve_links","opsec_exposure","saml_lint","kerberos_audit","delegation_paths","bundle_correlation","liveness_gaps","challenge_window","da_gaps"],"file":"backend/app/plugin_schema.py","id":"evidence_pack","kind":"harness","layer":3,"note":"Harness consumer: bundles analyzer outputs into the per-finding evidence pack (probe transcript, balances, code).","produces":["evidence_pack"]},{"consumes":["tainted_slots","selector_tree","cpi_traces","transfer_hook_resolution","paymaster_drain_shape"],"file":"backend/scripts/auto_validate.py","id":"auto_validator","kind":"harness","layer":3,"note":"Harness consumer: live-probe validator. Simulation-only inputs (paymaster_drain_shape) are capped at UNVERIFIED and can never become VERIFIED_REAL.","produces":["verdicts"]}],"version":"1.0.0"}