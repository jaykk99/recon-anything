# ReconAnything environment. Copy to .env and fill in.

# Database: Postgres in compose, SQLite file for single-container/local.
DATABASE_URL=postgresql+psycopg2://recon:recon@postgres:5432/recon
# DATABASE_URL=sqlite:///./recon.db

# Redis cache (optional; in-memory fallback is used when unset).
REDIS_URL=redis://redis:6379/0

# Single-user access code gate. Empty = no gate (local dev only).
RECON_ACCESS_CODE=

# Fernet key for encrypting stored API keys at rest (generate: python -c
# "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
RECON_MASTER_KEY=

# --- Optional third-party API keys (all optional; the app degrades gracefully) ---
# Shodan (port/service intel, favicon pivot)
SHODAN_API_KEY=
# HaveIBeenPwned (breach checks) - https://haveibeenpwned.com/API/v3
HIBP_API_KEY=
# GitHub token (code search for leaked keys) - https://github.com/settings/tokens
GITHUB_TOKEN=
# VirusTotal (passive DNS / URLs) - https://www.virustorm.com/
VIRUSTOTAL_API_KEY=
# SecurityTrails (passive DNS) - https://securitytrails.com/
SECURITYTRAILS_API_KEY=
# Censys (host intel) - https://censys.io/
CENSYS_API_ID=
CENSYS_API_SECRET=

RECON_TIMEOUT=20
RECON_CONCURRENCY=8
